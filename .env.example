# Copy to .env.local and fill these values from Supabase Dashboard > Connect
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Only use server-side. Never expose this key to client components.
SUPABASE_SECRET_KEY=sb_secret_your_server_only_key

# Resend (server-only). Verify sender domain and use an address from that domain.
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=TEMUKAN <no-reply@your-verified-domain.example>
